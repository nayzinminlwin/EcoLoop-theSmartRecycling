rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        ('admin' in request.auth.token) &&
        request.auth.token.admin == true;
    }

    match /simulation-assets/{assetId}/{assetVersion}/{fileName=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /reward-art/{rewardId}/{assetVersion}/{fileName=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /evaluation-data/{datasetVersion}/{fileName=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /inspection-evidence/{residentId}/{depositId}/{runId}/{fileName=**} {
      allow read: if isOwner(residentId) || isAdmin();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
