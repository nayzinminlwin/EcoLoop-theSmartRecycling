rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.token.role == 'admin' &&
        exists(/databases/$(database)/documents/adminAccounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminAccounts/$(request.auth.uid)).data.enabled == true;
    }

    function canReadCatalog() {
      return signedIn();
    }

    match /bins/{binId} {
      allow read: if canReadCatalog();
      allow write: if isAdmin();
    }

    match /binQrMappings/{mappingId} {
      allow read: if canReadCatalog() || isAdmin();
      allow write: if isAdmin();
    }

    match /binCycles/{cycleId} {
      allow read, write: if isAdmin();
    }

    match /binTombstones/{binId} {
      allow read, write: if false;
    }

    match /simulationAssets/{assetId} {
      allow read: if canReadCatalog();
      allow write: if false;
    }

    match /policies/{policyId} {
      allow read: if canReadCatalog();
      allow write: if false;
    }

    match /policyPointers/{pointerId} {
      allow read: if canReadCatalog();
      allow write: if false;
    }

    match /rewards/{rewardId} {
      allow read: if canReadCatalog() || isAdmin();
      allow write: if isAdmin();
    }

    match /rewardCategories/{categoryId} {
      allow read: if canReadCatalog() || isAdmin();
      allow write: if isAdmin();
    }

    match /guideContent/{contentId} {
      allow read: if canReadCatalog();
      allow write: if false;
    }

    match /guideMaterials/{materialId} {
      allow read: if canReadCatalog();
      allow write: if false;
    }

    match /guideSteps/{stepId} {
      allow read: if canReadCatalog();
      allow write: if false;
    }

    match /scanContent/{contentId} {
      allow read: if canReadCatalog();
      allow write: if false;
    }

    match /residents/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if false;

      match /{subcollection}/{documentId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /depositSessions/{sessionId} {
      allow read: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if signedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /deposits/{batchId} {
      allow read: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /receipts/{receiptId} {
      allow read: if signedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    match /depositResults/{receiptId} {
      allow read: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /walletEntries/{entryId} {
      allow read: if (signedIn() && resource.data.residentId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    match /vouchers/{voucherId} {
      allow read: if (signedIn() && resource.data.residentId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /inferenceJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;

      match /{subcollection}/{documentId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /reviewTickets/{ticketId} {
      allow read, write: if isAdmin();
    }

    match /adminAccounts/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /adminSettings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminOperations/{operationId} {
      allow read, write: if false;
    }

    match /adminIntents/{intentId} {
      allow read, write: if false;
    }

    match /adminAuditEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminBinViews/{binId} {
      allow read, write: if isAdmin();
    }

    match /adminAlertViews/{alertId} {
      allow read, write: if isAdmin();
    }

    match /capacityAlerts/{alertId} {
      allow read, write: if isAdmin();
    }

    match /binCollectionState/{binId} {
      allow read, write: if isAdmin();
    }

    match /collectionEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /adminReviewViews/{reviewId} {
      allow read, write: if isAdmin();
    }

    match /adminRewardViews/{rewardId} {
      allow read, write: if isAdmin();
    }

    match /adminRewardCategoryViews/{categoryId} {
      allow read, write: if isAdmin();
    }

    match /adminReadVersions/{topic} {
      allow read, write: if isAdmin();
    }

    match /adminDashboard/{dashboardId} {
      allow read, write: if isAdmin();
    }

    match /adminDashboardViews/{dashboardId} {
      allow read, write: if isAdmin();
    }

    match /notificationEvents/{eventId} {
      allow read: if signedIn() &&
        resource.data.recipientUid == request.auth.uid;
      allow write: if false;
    }

    match /retentionEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
