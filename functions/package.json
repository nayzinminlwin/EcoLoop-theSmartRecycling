{
  "name": "@ecoloop/functions",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/copy-contracts.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-ecoloop \"npm run test:rules:runner\"",
    "test:rules:runner": "vitest run --config vitest.rules.config.ts",
    "test:unit": "vitest run",
    "test": "npm run build && npm run test:unit"
  },
  "dependencies": {
    "@google-cloud/tasks": "5.5.0",
    "ajv-formats": "3.0.1",
    "firebase-admin": "13.5.0",
    "firebase-functions": "6.6.0"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "ajv": "8.17.1",
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-functions-test": "3.4.1",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  }
}
