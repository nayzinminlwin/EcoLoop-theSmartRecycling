{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecoloop.invalid/schemas/evaluation-annotations-v1.json",
  "title": "EcoLoop evaluation image manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasetVersion", "purpose", "status", "counts", "images"],
  "properties": {
    "datasetVersion": {
      "type": "string",
      "pattern": "^evaluation-[0-9]{4}-[0-9]{2}-[0-9]{2}-v[0-9]+$"
    },
    "purpose": {
      "const": "evaluation-only"
    },
    "status": {
      "enum": ["scaffolding", "labeling", "frozen", "superseded"]
    },
    "owner": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "handoffPath": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoried",
        "labeled",
        "development",
        "frozenEvaluation",
        "secondReviewed"
      ],
      "properties": {
        "inventoried": {
          "type": "integer",
          "minimum": 0
        },
        "labeled": {
          "type": "integer",
          "minimum": 0
        },
        "development": {
          "type": "integer",
          "minimum": 0
        },
        "frozenEvaluation": {
          "type": "integer",
          "minimum": 0
        },
        "secondReviewed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageId",
        "sourceRef",
        "sha256",
        "bytes",
        "width",
        "height",
        "format",
        "sceneGroupId",
        "split",
        "category",
        "annotationStatus",
        "reviewer",
        "annotationVersion",
        "annotations"
      ],
      "properties": {
        "imageId": {
          "type": "string",
          "pattern": "^img-[0-9]{4}$"
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "enum": ["jpeg", "png", "webp", "svg"]
        },
        "sceneGroupId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "split": {
          "enum": ["development", "frozen-evaluation", "unassigned"]
        },
        "category": {
          "enum": ["clear", "difficult", "empty", "excluded", "unclassified"]
        },
        "annotationStatus": {
          "enum": ["unlabeled", "first-reviewed", "second-reviewed", "frozen"]
        },
        "reviewer": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "annotationVersion": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "annotations": {
          "type": ["array", "null"],
          "items": {
            "$ref": "#/$defs/objectAnnotation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "annotationStatus": {
                "const": "unlabeled"
              }
            }
          },
          "then": {
            "properties": {
              "split": {
                "const": "unassigned"
              },
              "category": {
                "const": "unclassified"
              },
              "annotations": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "objectAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "bbox",
        "label",
        "eligibility",
        "difficulty"
      ],
      "properties": {
        "objectId": {
          "type": "string",
          "pattern": "^img-[0-9]{4}-object-[0-9]{2}$"
        },
        "bbox": {
          "$ref": "#/$defs/normalizedBox"
        },
        "label": {
          "enum": [
            "plastic_bottle",
            "aluminium_can",
            "glass_bottle",
            "paper_item",
            "paper_bag",
            "cardboard_item",
            "other",
            "unknown"
          ]
        },
        "eligibility": {
          "enum": ["eligible", "ineligible", "unresolved"]
        },
        "difficulty": {
          "enum": ["clear", "difficult", "occluded", "overlapping"]
        },
        "notes": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    },
    "normalizedBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x1", "y1", "x2", "y2"],
      "properties": {
        "x1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
